<?xml version="1.0" encoding="utf-8"?><!--
   Chora is a self-hosted client: talking to a Navidrome/Subsonic server over
   plain http:// on a LAN is a first-class use case, so cleartext stays allowed
   (the server URL is user-configured, and the app additionally has an explicit
   per-server "allow self-signed certificate" toggle that installs a scoped
   trust-all OkHttp engine for that one host).

   What was removed: <certificates src="user"/>. Trusting user-installed CAs for
   EVERY host meant any CA a user (or an MDM profile, or an attacker with a
   one-tap prompt) installed could transparently MITM all traffic app-wide.
   Self-signed servers are handled by the per-server toggle instead, which is
   scoped to the one configured domain.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
