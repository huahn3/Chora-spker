<?xml version="1.0" encoding="utf-8"?><!--
   Exclude the credential store from backup.

   NavidromeManager persists the server list (url, username AND plaintext
   password) in the "NavidromePrefs" shared preferences file. With the default
   rules that file was included, so cloud auto-backup / device-to-device
   transfer / `adb backup` all carried the account credentials off the device.

   Everything else (playlists, settings, DataStore) stays backup-able.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="NavidromePrefs.xml" />
</full-backup-content>
