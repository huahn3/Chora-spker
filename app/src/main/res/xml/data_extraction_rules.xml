<?xml version="1.0" encoding="utf-8"?><!--
   See backup_rules.xml: NavidromePrefs.xml holds the plaintext server password
   and must never leave the device, not even through device-to-device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="NavidromePrefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="NavidromePrefs.xml" />
    </device-transfer>
</data-extraction-rules>
